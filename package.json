{
    "name":  "civic-resolve-ai",
    "private":  true,
    "version":  "0.1.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "concurrently -k -p \"[{name}]\" -n \"CLIENT,SERVER\" -c \"cyan.bold,green.bold\" \"npm run dev:client\" \"npm run dev:server\"",
                    "dev:client":  "vite",
                    "dev:server":  "tsx watch backend/server/server.ts",
                    "build":  "tsc -b \u0026\u0026 vite build \u0026\u0026 tsc -p backend/tsconfig.json",
                    "build:client":  "tsc -b \u0026\u0026 vite build",
                    "build:server":  "tsc -p backend/tsconfig.json",
                    "start":  "tsx backend/server/server.ts",
                    "seed":  "tsx backend/database/seed.ts",
                    "test:api":  "tsx backend/test_api.ts",
                    "lint":  "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
                    "preview":  "vite preview",
                    "verify:db":  "tsx backend/verify_db.ts"
                },
    "dependencies":  {
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.7",
                         "express":  "^4.21.2",
                         "lucide-react":  "^0.462.0",
                         "pg":  "^8.13.1",
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1",
                         "react-router-dom":  "^6.28.0"
                     },
    "devDependencies":  {
                            "@types/cors":  "^2.8.17",
                            "@types/express":  "^4.17.21",
                            "@types/node":  "^20.17.0",
                            "@types/pg":  "^8.11.10",
                            "@types/react":  "^18.3.12",
                            "@types/react-dom":  "^18.3.1",
                            "@vitejs/plugin-react":  "^4.3.3",
                            "autoprefixer":  "^10.4.20",
                            "concurrently":  "^9.1.2",
                            "postcss":  "^8.4.49",
                            "tailwindcss":  "^3.4.15",
                            "tsx":  "^4.19.2",
                            "typescript":  "^5.6.3",
                            "vite":  "^5.4.10"
                        }
}