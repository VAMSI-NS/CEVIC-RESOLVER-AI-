# Environment Variables for CivicResolve AI
# Copy this file to .env and fill in real values for production.
# For the hackathon demo, all AI functionality is simulated — no API keys required.

# ── AI Integration (optional — mock AI used by default) ──────────────────────
# When set, these are used instead of the simulated AI service.
# VITE_GEMINI_API_KEY=
# VITE_OPENAI_API_KEY=

# ── Maps Integration (optional) ───────────────────────────────────────────────
# Uncomment and fill in to replace the simulated SVG map with a real map.
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_MAPBOX_TOKEN=

# ── Backend API (optional) ────────────────────────────────────────────────────
# When set, complaint data is sent to a real backend instead of LocalStorage.
# VITE_API_BASE_URL=

# ── App Settings ─────────────────────────────────────────────────────────────
VITE_APP_NAME=CivicResolve AI
VITE_APP_VERSION=1.0.0
# Set to "true" to show a demo mode banner
VITE_DEMO_MODE=true
